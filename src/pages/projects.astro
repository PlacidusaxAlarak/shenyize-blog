---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const title = "项目";
const description = "我做过的一些项目与实验，包含工程实践与算法实现。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full">
			<h1 class="text-3xl md:text-[2.25rem]/[2.75rem] font-bold text-90 mb-3">{title}</h1>
			<p class="text-75 text-sm md:text-base mb-6">{description}</p>

			<div class="grid gap-4">
				<div class="card-base p-5">
					<div class="text-xl font-bold text-90 mb-2">项目一：写点标题</div>
					<p class="text-75 text-sm mb-3">一句话概括项目目标与亮点，补充技术栈与成果。</p>
					<div class="flex flex-wrap gap-2 text-xs text-50">
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">Tech</span>
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">Astro</span>
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">AI</span>
					</div>
				</div>

				<div class="card-base p-5">
					<div class="text-xl font-bold text-90 mb-2">项目二：写点标题</div>
					<p class="text-75 text-sm mb-3">描述你的角色、关键贡献、可量化结果。</p>
					<div class="flex flex-wrap gap-2 text-xs text-50">
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">C++</span>
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">工程</span>
					</div>
				</div>

				<div class="card-base p-5">
					<div class="text-xl font-bold text-90 mb-2">项目三：写点标题</div>
					<p class="text-75 text-sm mb-3">可以放竞赛 / 研究 / 个人工具类项目。</p>
					<div class="flex flex-wrap gap-2 text-xs text-50">
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">算法</span>
						<span class="px-2 py-1 rounded-md bg-black/5 dark:bg-white/10">工具</span>
					</div>
				</div>
			</div>

			<div class="border-[var(--line-divider)] border-dashed border-t-[1px] my-6"></div>

			<div class="text-75 text-sm">
				如果你想快速了解我的技术路线，可以直接浏览
				<a class="link-underline" href={url("/solutions/")}>题解</a>。
			</div>
		</div>
	</div>
</MainGridLayout>
