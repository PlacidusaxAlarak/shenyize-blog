---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const title = "项目";
const description = "这里收录站点里的公开内容与持续整理中的实验记录。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full">
			<h1 class="text-3xl md:text-[2.25rem]/[2.75rem] font-bold text-90 mb-3">{title}</h1>
			<p class="text-75 text-sm md:text-base mb-6">{description}</p>

			<article class="card-base p-5 flex flex-col gap-3">
				<h2 class="text-xl font-bold text-90">当前公开内容</h2>
				<p class="text-75 text-sm">
					独立验证码演示页已移除，站点当前只保留文章访问流程中的圆形旋转验证码。
				</p>
				<p class="text-75 text-sm">
					你可以继续浏览<a class="link-underline" href={url("/solutions/")}>题解</a>与其他文章内容。
				</p>
			</article>
		</div>
	</div>
</MainGridLayout>
