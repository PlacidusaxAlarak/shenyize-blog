---
import { getArticleCaptchaBackgroundImageUrls } from "./background-image-pool.mjs";

interface Props {
	storageKey?: string;
	backgroundImageUrl?: string;
	fallbackBackgroundImageUrl?: string;
}

const {
	storageKey = "site-captcha:passed",
	backgroundImageUrl = "/captcha/preview.jpg",
	fallbackBackgroundImageUrl = "/captcha/placeholder-background.svg",
} = Astro.props;
const backgroundImageUrls = await getArticleCaptchaBackgroundImageUrls({
	fallbackUrls: [backgroundImageUrl],
});
---

<div
	data-article-captcha-gate
	class="article-captcha-gate"
	data-storage-key={storageKey}
	data-background-image-url={backgroundImageUrl}
	data-background-image-urls={JSON.stringify(backgroundImageUrls)}
	data-fallback-background-image-url={fallbackBackgroundImageUrl}
	data-gate-state="locked"
>
	<div class="article-captcha-content" data-article-captcha-content>
		<slot />
	</div>

	<div
		class="article-captcha-overlay"
		data-article-captcha-overlay
		role="dialog"
		aria-modal="true"
		aria-labelledby="article-captcha-title"
		aria-describedby="article-captcha-description"
	>
		<div class="article-captcha-overlay-backdrop"></div>
		<div class="article-captcha-card" data-article-captcha-card>
			<div class="article-captcha-header">
				<h2 id="article-captcha-title" class="article-captcha-title">安全验证</h2>
				<p id="article-captcha-description" class="article-captcha-sr-only">
					拖动滑块完成验证。
				</p>
			</div>

			<div class="article-captcha-canvas-frame" data-article-captcha-canvas-frame>
				<canvas
					class="article-captcha-canvas"
					data-article-captcha-canvas
					width="620"
					height="620"
					aria-label="验证码画布"
				></canvas>
			</div>
		</div>

		<div
			class="article-captcha-controls"
			data-article-captcha-controls
			data-positioned="false"
		>
			<div class="article-captcha-slider-panel">
				<label class="article-captcha-sr-only" for="article-captcha-slider">
					拖动滑块完成验证
				</label>
				<input
					id="article-captcha-slider"
					class="article-captcha-slider"
					data-article-captcha-slider
					type="range"
					min="0"
					max="100"
					value="0"
					step="0.01"
				/>
			</div>

			<div class="article-captcha-status-panel">
				<p
					class="article-captcha-status"
					data-article-captcha-status
					data-state="loading"
					role="status"
					aria-live="polite"
				>
					正在加载验证码...
				</p>
			</div>
		</div>
	</div>
</div>

<style>
	.article-captcha-gate {
		position: relative;
	}

	.article-captcha-overlay[hidden] {
		display: none;
	}

	.article-captcha-overlay {
		--article-captcha-overlay-padding: clamp(12px, 2.8dvh, 24px);
		--article-captcha-canvas-limit: 700px;
		position: fixed;
		inset: 0;
		z-index: 110;
		display: grid;
		place-items: center;
		padding: clamp(12px, 2.8dvh, 24px) 18px;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.article-captcha-overlay-backdrop {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px),
			radial-gradient(circle at top left, rgba(255, 237, 196, 0.92), transparent 42%),
			radial-gradient(circle at right 18%, rgba(214, 132, 68, 0.28), transparent 28%),
			linear-gradient(135deg, #f6ead1 0%, #efe0bf 44%, #e7d4a8 100%);
		background-size:
			22px 22px,
			22px 22px,
			auto,
			auto,
			auto;
		backdrop-filter: blur(8px);
	}

	.article-captcha-card {
		--article-captcha-paper: #f7f0dc;
		--article-captcha-ink: #1c1d20;
		--article-captcha-muted: #5d615f;
		--article-captcha-accent: #c96a2c;
		--article-captcha-accent-strong: #7f3f1b;
		--article-captcha-border: rgba(28, 29, 32, 0.1);
		--article-captcha-card-shadow: 0 24px 60px rgba(39, 30, 14, 0.22);
		position: relative;
		z-index: 1;
		width: fit-content;
		max-width: min(100%, 860px);
		max-height: calc(100dvh - (var(--article-captcha-overlay-padding) * 2));
		padding: clamp(16px, 2.2dvh, 22px);
		border: 1px solid var(--article-captcha-border);
		border-radius: 28px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 248, 235, 0.88)),
			var(--article-captcha-paper);
		box-shadow: var(--article-captcha-card-shadow);
		backdrop-filter: blur(10px);
		font-family:
			"Microsoft YaHei",
			"PingFang SC",
			"Noto Sans SC",
			"Trebuchet MS",
			sans-serif;
		color: var(--article-captcha-ink);
		display: grid;
		gap: clamp(12px, 1.8dvh, 18px);
		overflow: hidden;
	}

	.article-captcha-controls {
		position: absolute;
		top: var(--article-captcha-controls-top, 18px);
		left: var(--article-captcha-controls-left, 18px);
		z-index: 2;
		width: min(360px, calc(100vw - 36px));
		display: grid;
		gap: 10px;
		padding: 14px;
		border-radius: 24px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 245, 226, 0.86)),
			rgba(247, 240, 220, 0.92);
		border: 1px solid rgba(28, 29, 32, 0.08);
		box-shadow: 0 20px 44px rgba(39, 30, 14, 0.2);
		backdrop-filter: blur(10px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms ease;
	}

	.article-captcha-controls[data-positioned="true"] {
		opacity: 1;
		pointer-events: auto;
	}

	.article-captcha-header {
		display: grid;
		gap: 0;
	}

	.article-captcha-title {
		margin: 0;
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: 1.1;
		color: var(--article-captcha-ink);
	}

	.article-captcha-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.article-captcha-canvas-frame {
		width: min(100%, var(--article-captcha-canvas-limit, 700px));
		justify-self: center;
		padding: clamp(8px, 1.2dvh, 12px);
		border-radius: 24px;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.84), rgba(255, 243, 219, 0.92));
		border: 1px solid rgba(28, 29, 32, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
	}

	.article-captcha-canvas {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		border-radius: 18px;
		background: #f2e7cf;
	}

	.article-captcha-slider-panel {
		padding: 0;
	}

	.article-captcha-slider {
		width: 100%;
		margin: 0;
		appearance: none;
		height: 20px;
		border-radius: 999px;
		border: 1px solid rgba(28, 29, 32, 0.08);
		background:
			linear-gradient(
				90deg,
				#c96a2c 0%,
				#f1a955 var(--range-progress, 0%),
				rgba(28, 29, 32, 0.1) var(--range-progress, 0%),
				rgba(28, 29, 32, 0.1) 100%
			);
		box-shadow: inset 0 1px 3px rgba(28, 29, 32, 0.12);
	}

	.article-captcha-slider:disabled {
		opacity: 0.72;
		cursor: not-allowed;
	}

	.article-captcha-slider::-webkit-slider-thumb {
		appearance: none;
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: 50%;
		background:
			radial-gradient(circle at 32% 32%, #fff7e8 0%, #fbe6b7 34%, #d97832 36%, #8e4318 100%);
		box-shadow:
			0 8px 20px rgba(72, 30, 6, 0.24),
			0 0 0 3px rgba(255, 255, 255, 0.5);
		cursor: grab;
	}

	.article-captcha-slider::-moz-range-thumb {
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: 50%;
		background:
			radial-gradient(circle at 32% 32%, #fff7e8 0%, #fbe6b7 34%, #d97832 36%, #8e4318 100%);
		box-shadow:
			0 8px 20px rgba(72, 30, 6, 0.24),
			0 0 0 3px rgba(255, 255, 255, 0.5);
		cursor: grab;
	}

	.article-captcha-slider::-moz-range-track {
		height: 20px;
		border-radius: 999px;
		background: transparent;
	}

	.article-captcha-status-panel {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		justify-content: flex-start;
	}

	.article-captcha-status {
		margin: 0;
		padding: 10px 14px;
		border-radius: 999px;
		background: rgba(28, 29, 32, 0.08);
		color: var(--article-captcha-ink);
		font-weight: 700;
	}

	.article-captcha-status[data-state="success"] {
		background: rgba(43, 142, 104, 0.16);
		color: #1d6b4c;
	}

	.article-captcha-status[data-state="error"] {
		background: rgba(196, 78, 38, 0.16);
		color: #9b3b18;
	}

	.article-captcha-status[data-state="loading"] {
		background: rgba(58, 96, 154, 0.16);
		color: #274f83;
	}

	.article-captcha-content {
		position: relative;
		transition:
			filter 220ms ease,
			opacity 220ms ease;
	}

	.article-captcha-content::after {
		content: "";
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 220ms ease;
	}

	[data-gate-state="locked"] [data-article-captcha-content] {
		filter: blur(18px);
		opacity: 0.24;
		pointer-events: none;
		user-select: none;
	}

	[data-gate-state="locked"] [data-article-captcha-content]::after {
		opacity: 1;
		background: rgba(255, 247, 236, 0.4);
	}

	:global(body.article-captcha-locked) {
		overflow: hidden;
	}

	@media (max-width: 720px) {
		.article-captcha-card {
			border-radius: 24px;
		}
	}
</style>
